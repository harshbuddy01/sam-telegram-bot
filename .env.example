# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram IDs (Comma-separated for multiple admins)
ADMIN_IDS=your_telegram_id_here

# Payment & Store Settings
UPI_ID=your-upi-id@oksbi
UPI_NAME=Sam Store Services
CURRENCY_SYMBOL=₹
SUPPORT_USERNAME=@YourSupportHandle
CHANNEL_LINK=https://t.me/SamStoreServices
GROUP_LINK=https://t.me/SamStoreServices

# Automated Payment Gateways
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# PayPal Gateway Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=SANDBOX
PAYPAL_CURRENCY=USD
PAYPAL_USD_TO_INR_RATE=85.0
PAYPAL_SURCHARGE_PERCENT=5.0
PAYPAL_WEBHOOK_ID=

# Referral Bonus
REFERRAL_BONUS_PERCENT=5.0

# Database Path
DB_PATH=/app/data/store.db
